# Local development: copy to `.env` and adjust. Never commit `.env`.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
DEMO_MODE=false

# Production only (DEBUG=false):
# ALLOWED_HOSTS=fixflow-api.onrender.com
# CSRF_TRUSTED_ORIGINS=https://fixflow-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://fixflow-web.onrender.com
# CORS_ALLOWED_ORIGIN_REGEXES=^https://fixflow-web[a-z0-9-]*\.onrender\.com$

# Production database (Neon Postgres). When unset, local dev falls back to SQLite.
# Use the pooled connection string and keep sslmode=require.
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/fixflow?sslmode=require
